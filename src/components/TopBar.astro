---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
import { loadVisitorStats } from '../lib/visitors';
interface Props { section: 'academic' | 'blog' | 'conference' | 'dev' | 'exposure' }
const { section } = Astro.props;
const sections = [
  { id: 'news', label: 'News' },
  { id: 'publications', label: 'Publications' },
  { id: 'experience', label: 'Experience' },
];
const blogLinks = [
  { href: '/blog/', label: 'Notes' },
  // the visitor map exists only when statistics were fetched (or in development)
  ...((await loadVisitorStats()) || import.meta.env.DEV ? [{ href: '/blog/#visitors', label: 'Visitors', spy: 'visitors' }] : []),
];
---
<header class="topbar" transition:persist="topbar">
  <div class="topbar__inner">
    <div class="topbar__left">
      <a class="topbar__name" href="/">{profile.name}</a>
      <nav class="sections" aria-label="Sections" data-sections hidden={section !== 'academic'}>
        {sections.map((s) => <a href={`/#${s.id}`} data-spy={s.id}>{s.label}</a>)}
      </nav>
      <nav class="sections" aria-label="Blog" data-blognav hidden={section !== 'blog'}>
        {blogLinks.map((l) => <a href={l.href} data-spy={l.spy} data-path={l.spy ? undefined : l.href}>{l.label}</a>)}
      </nav>
    </div>
    <nav class="capsule" data-active={section} aria-label="Site section">
      <a href="/" data-seg="academic" aria-current={section === 'academic' ? 'page' : undefined}>About</a>
      <a href="/blog/" data-seg="blog" aria-current={section === 'blog' ? 'page' : undefined}>Blog</a>
      {/* below 450px the data-fold segments fold into the "more" button, except the current one */}
      <a href="/conference/" data-seg="conference" data-fold aria-current={section === 'conference' ? 'page' : undefined}>Conference</a>
      <a href="/dev/" data-seg="dev" data-fold aria-current={section === 'dev' ? 'page' : undefined}>Dev</a>
      <a href="/exposure/" data-seg="exposure" data-fold aria-current={section === 'exposure' ? 'page' : undefined}>Exposure</a>
      <button class="capsule__more" type="button" data-capsule-more aria-expanded="false" aria-label="More sections" title="More sections">
        <Icon name="more" />
      </button>
      <span class="capsule__thumb" aria-hidden="true"></span>
    </nav>
    <div class="topbar__tools">
      <button class="icon-btn" type="button" data-motion-toggle aria-pressed="false" aria-label="Pause background animation" title="Pause or play the background">
        <Icon name="pause" class="i-pause" /><Icon name="play" class="i-play" />
      </button>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch to dark mode" title="Light or dark">
        <Icon name="moon" class="i-moon" /><Icon name="sun" class="i-sun" />
      </button>
    </div>
  </div>
</header>

<script>
  // The top bar persists across view transitions; keep it in sync with the URL and settings.
  const root = document.documentElement;

  /** slide the thumb under the active segment (segments have different widths) */
  function placeThumb() {
    const capsule = document.querySelector<HTMLElement>('.capsule');
    const a = capsule?.querySelector<HTMLElement>(`a[data-seg="${capsule.dataset.active}"]`);
    if (!capsule || !a || !a.offsetWidth) return;
    capsule.style.setProperty('--thumb-x', `${a.offsetLeft}px`);
    capsule.style.setProperty('--thumb-w', `${a.offsetWidth}px`);
    if (!capsule.classList.contains('is-measured')) {
      capsule.classList.add('is-measured');
      requestAnimationFrame(() => requestAnimationFrame(() => capsule.classList.add('is-ready')));
    }
  }

  // Below 450px Conference, Dev and Exposure fold into the "more" button (the current one stays).
  const narrow = matchMedia('(max-width: 449px)');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const MORPH = { duration: 320, easing: 'cubic-bezier(0.2, 0, 0, 1)' };

  function setOpen(capsule: HTMLElement, open: boolean) {
    capsule.classList.toggle('is-open', open);
    capsule.querySelector('[data-capsule-more]')?.setAttribute('aria-expanded', String(open));
  }
  function setCurrent(capsule: HTMLElement, seg: string) {
    capsule.dataset.active = seg;
    capsule.querySelectorAll<HTMLAnchorElement>('a[data-seg]').forEach((a) => {
      if (a.dataset.seg === seg) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
  }

  /** change which segments show, then let segments, thumb and capsule glide from where they were */
  function morph(capsule: HTMLElement, change: () => void) {
    if (!narrow.matches || reduceMotion.matches || !capsule.classList.contains('is-ready')) {
      change();
      placeThumb();
      return;
    }
    const items = [...capsule.querySelectorAll<HTMLElement>('a[data-seg], [data-capsule-more]')];
    const thumb = capsule.querySelector<HTMLElement>('.capsule__thumb')!;
    const r0 = items.map((el) => el.getBoundingClientRect());
    const t0 = thumb.getBoundingClientRect();
    const w0 = capsule.getBoundingClientRect().width;
    capsule.classList.add('is-snapping'); // the thumb's own transition would override the animation below
    change();
    placeThumb();
    const t1 = thumb.getBoundingClientRect();
    const w1 = capsule.getBoundingClientRect().width;
    capsule.classList.remove('is-snapping');

    capsule.classList.add('is-animating');
    capsule.animate([{ width: `${w0}px` }, { width: `${w1}px` }], MORPH).finished.finally(() => {
      if (!capsule.getAnimations().some((a) => a.playState === 'running')) capsule.classList.remove('is-animating');
    });
    if (t0.width && t1.width) {
      const x = parseFloat(capsule.style.getPropertyValue('--thumb-x')) || 0;
      thumb.animate(
        [
          { transform: `translateX(${x + t0.left - t1.left}px)`, width: `${t0.width}px` },
          { transform: `translateX(${x}px)`, width: `${t1.width}px` },
        ],
        MORPH,
      );
    }
    items.forEach((el, i) => {
      const r1 = el.getBoundingClientRect();
      if (!r1.width) return; // folded away
      if (r0[i].width) {
        const dx = r0[i].left - r1.left;
        if (Math.abs(dx) > 0.5) el.animate([{ transform: `translateX(${dx}px)` }, { transform: 'none' }], MORPH);
      } else {
        el.animate([{ opacity: 0 }, { opacity: 1 }], { ...MORPH, delay: 80, fill: 'backwards' }); // newly shown
      }
    });
  }

  function sync() {
    const p = location.pathname;
    const seg = p.startsWith('/blog')
      ? 'blog'
      : p.startsWith('/conference')
        ? 'conference'
        : p.startsWith('/dev')
          ? 'dev'
          : p.startsWith('/exposure')
            ? 'exposure'
            : 'academic';
    const capsule = document.querySelector<HTMLElement>('.capsule');
    if (capsule) {
      const current = capsule.querySelector<HTMLElement>('a[aria-current="page"]')?.dataset.seg;
      if (current !== seg || capsule.classList.contains('is-open')) {
        morph(capsule, () => {
          setCurrent(capsule, seg);
          setOpen(capsule, false);
        });
      } else {
        capsule.dataset.active = seg;
        placeThumb();
      }
    }
    const nav = document.querySelector<HTMLElement>('[data-sections]');
    if (nav) nav.hidden = !(document.body.dataset.stage === 'academic');
    const blognav = document.querySelector<HTMLElement>('[data-blognav]');
    if (blognav) {
      blognav.hidden = seg !== 'blog';
      blognav.querySelectorAll<HTMLAnchorElement>('a[data-path]').forEach((a) => {
        if (a.dataset.path === location.pathname) a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
      });
    }
    const motionOff = root.dataset.motion === 'off';
    const mb = document.querySelector<HTMLButtonElement>('[data-motion-toggle]');
    mb?.setAttribute('aria-pressed', String(motionOff));
    mb?.setAttribute('aria-label', motionOff ? 'Play background animation' : 'Pause background animation');
    const tb = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    tb?.setAttribute('aria-label', root.dataset.theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
  }

  // respond on press, not on release
  document.addEventListener('pointerdown', (e) => {
    if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const seg = (e.target as Element).closest<HTMLAnchorElement>('.capsule a[data-seg]');
    const capsule = seg?.closest<HTMLElement>('.capsule');
    if (seg && capsule && seg.dataset.seg) {
      capsule.dataset.active = seg.dataset.seg;
      placeThumb();
    }
  });
  // label widths change with the fluid type scale and once fonts settle
  window.addEventListener('resize', placeThumb);
  document.fonts?.ready.then(placeThumb);

  document.addEventListener('click', (e) => {
    const t = e.target as Element;
    const open = document.querySelector<HTMLElement>('.capsule.is-open');
    if (t.closest('[data-capsule-more]')) {
      const capsule = t.closest<HTMLElement>('.capsule')!;
      morph(capsule, () => setOpen(capsule, true));
      // from the keyboard, move focus to the first segment that just appeared
      if (e.detail === 0) capsule.querySelector<HTMLElement>('a[data-fold]:not([aria-current])')?.focus();
      return;
    }
    if (open) {
      const seg = t.closest<HTMLAnchorElement>('.capsule a[data-seg]');
      const follows = seg && !(e.metaKey || e.ctrlKey || e.shiftKey || e.altKey);
      if (seg || !t.closest('.capsule')) {
        morph(open, () => {
          if (follows && seg.dataset.seg) setCurrent(open, seg.dataset.seg);
          setOpen(open, false);
        });
      }
    }
    if (t.closest('[data-theme-toggle]')) {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
      window.dispatchEvent(new CustomEvent('themechange', { detail: next }));
      sync();
    } else if (t.closest('[data-motion-toggle]')) {
      const off = root.dataset.motion !== 'off';
      if (off) root.dataset.motion = 'off'; else delete root.dataset.motion;
      try { localStorage.setItem('motion', off ? 'off' : 'on'); } catch {}
      window.dispatchEvent(new CustomEvent('motionchange', { detail: off ? 'off' : 'on' }));
      sync();
    }
  });

  document.addEventListener('keydown', (e) => {
    const open = document.querySelector<HTMLElement>('.capsule.is-open');
    if (e.key !== 'Escape' || !open) return;
    const inside = open.contains(document.activeElement);
    morph(open, () => setOpen(open, false));
    if (inside) open.querySelector<HTMLElement>('[data-capsule-more]')?.focus();
  });
  document.addEventListener('focusout', (e) => {
    const open = (e.target as Element).closest?.<HTMLElement>('.capsule.is-open');
    const next = e.relatedTarget as Element | null;
    if (open && next && !open.contains(next)) morph(open, () => setOpen(open, false));
  });
  narrow.addEventListener('change', () => {
    const open = document.querySelector<HTMLElement>('.capsule.is-open');
    if (open) setOpen(open, false);
    placeThumb();
  });

  // scroll-spy for the section links (academic page only)
  let spy: IntersectionObserver | null = null;
  function bindSpy() {
    spy?.disconnect();
    const links = new Map<string, HTMLAnchorElement>();
    document.querySelectorAll<HTMLAnchorElement>('[data-spy]').forEach((a) => links.set(a.dataset.spy!, a));
    const targets = [...links.keys()].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
    if (!targets.length) return;
    const visible = new Set<string>();
    spy = new IntersectionObserver(
      (entries) => {
        for (const en of entries) {
          if (en.isIntersecting) visible.add(en.target.id);
          else visible.delete(en.target.id);
        }
        const current = targets.find((t) => visible.has(t.id))?.id;
        links.forEach((a, id) => {
          if (id === current) a.setAttribute('aria-current', 'location');
          else a.removeAttribute('aria-current');
        });
      },
      { rootMargin: '-35% 0px -55% 0px' },
    );
    targets.forEach((t) => spy!.observe(t));
  }

  document.addEventListener('astro:page-load', () => {
    sync();
    bindSpy();
  });
  sync();
</script>

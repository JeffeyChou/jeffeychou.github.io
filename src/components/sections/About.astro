---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { profile } from '../../data/profile';
// Portrait slot: src/assets/photo.{jpg,png,webp}. Astro resizes it and serves WebP at build time, so the
// original can stay full size. An empty frame until a file is added.
const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/photo.{jpg,jpeg,png,webp}', { eager: true });
const photo = Object.values(photos)[0]?.default;
---
<section class="hero" id="about" aria-labelledby="about-title">
  <div class="hero__text">
    <h1 id="about-title">{profile.name}<span lang="zh">{profile.nameZh}</span></h1>
    <p class="hero__role">
      {profile.role}<br />
      {profile.affiliation}
    </p>
    <p class="links">
      {profile.links.map((l) => (
        <a href={l.href} rel={l.href.startsWith('http') ? 'me noopener' : undefined}>{l.kind === 'email' ? profile.email : l.label}</a>
      ))}
    </p>
    <div class="bio">
      {profile.bio.map((p) => <p set:html={p} />)}
    </div>
  </div>

  <aside class="hero__side" aria-label="Photo and address">
    {photo ? (
      <Image
        class="hero__photo"
        src={photo}
        alt={`Portrait of ${profile.name}`}
        widths={[240, 480, 720]}
        sizes="(max-width: 899px) 7.5rem, 17rem"
        loading="eager"
      />
    ) : (
      <div class="hero__photo hero__photo--empty meta" aria-hidden="true">Photo</div>
    )}
    <address class="small hero__address">
      {profile.address.map((line) => <span>{line}</span>)}
    </address>
  </aside>
</section>
